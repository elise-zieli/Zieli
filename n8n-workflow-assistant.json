                      "id":  "9003f8c7-b369-484c-a649-518a30ca2c0b"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Récupère le texte de la réponse et y joint les sources (titres des passages utilisés).\nconst p = $(\u0027Choisir les passages\u0027).first().json;\nconst texte = (($input.first().json.choices || [])[0]?.message?.content || \u0027\u0027).trim();\nconst reponse = texte || \"Désolé, je n\u0027ai pas pu répondre. Vous pouvez écrire à Elise avec le bloc « Une remarque / une question ? ».\";\nreturn [{ json: { reponse, sources: p.sources, question: p.question, entrepriseId: p.entrepriseId } }];"
                                     },
