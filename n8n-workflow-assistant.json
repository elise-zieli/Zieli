                                   ],
                      "webhookId":  "828af5dc-1939-4aeb-ac53-2b4839cbea27",
                      "id":  "d76af82c-9a46-45d4-944f-d39b4403f118"
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// Vérifie et nettoie ce qu\u0027envoie le site : la question (500 caractères max),\n// l\u0027entreprise (identifiant Airtable) et les derniers échanges (pour les questions de suite).\nconst corps = $input.first().json.body || {};\nconst question = String(corps.question || \u0027\u0027).trim().slice(0, 500);\nif (!question) throw new Error(\u0027Question vide\u0027);\nconst entrepriseId = /^rec[A-Za-z0-9]{14}$/.test(String(corps.entrepriseId || \u0027\u0027)) ? corps.entrepriseId : \u0027\u0027;\nconst historique = (Array.isArray(corps.historique) ? corps.historique : [])\n  .filter((m) =\u003e m \u0026\u0026 (m.role === \u0027user\u0027 || m.role === \u0027assistant\u0027) \u0026\u0026 typeof m.content === \u0027string\u0027)\n  .slice(-6)\n  .map((m) =\u003e ({ role: m.role, content: m.content.slice(0, 1500) }));\nreturn [{ json: { question, entrepriseId, historique } }];"
                                     },
                      "name":  "Preparer question",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       220,
                                       0
                                   ],
                      "id":  "ca55982a-c1a6-45a4-bde4-8c1f7eb549b3"
                  },
                  {
                      "parameters":  {
                                         "method":  "POST",
                                         "url":  "https://api.openai.com/v1/embeddings",
                                         "authentication":  "predefinedCredentialType",
                                         "nodeCredentialType":  "openAiApi",
                                         "sendBody":  true,
                                         "specifyBody":  "json",
                                         "jsonBody":  "={{ JSON.stringify({ model: \"text-embedding-3-small\", input: $json.question }) }}",
                                         "options":  {

                                                     }
                                     },
                      "name":  "Embedding question",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       440,
