                                   ],
                      "id":  "ddeabbaf-bbf7-4110-bdf4-15f1bbf02c07"
                  },
                  {
                      "parameters":  {
                                         "resource":  "record",
                                         "operation":  "search",
                                         "base":  {
                                                      "__rl":  true,
                                                      "value":  "app3K4PQkkZFAxipC",
                                                      "mode":  "id"
                                                  },
                                         "table":  {
                                                       "__rl":  true,
                                                       "value":  "tblOmbXZr14S1Q7Z5",
                                                       "mode":  "id"
                                                   },
                                         "filterByFormula":  "{Embedding} != \u0027\u0027",
                                         "returnAll":  true,
                                         "options":  {

